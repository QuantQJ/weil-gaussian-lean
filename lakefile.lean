  "https://github.com/leanprover-community/mathlib4" @ "v4.35.0"

-- OpenAI `math` (github.com/openai/math @ 4eaee87, Apache-2.0; see NOTICE): the import closure of
-- `OAI.NumberTheory.DirichletL.Nonvanishing`, vendored under OAI/ (incl. OAI/Vendor/ for its
-- PrimeNumberTheoremAnd and rellich-kondrachov dependencies). Built on demand via `QuasiRHProved`.
lean_lib OAI where
  srcDir := "."
  globs := #[.submodules `OAI]

-- Copied from QJ's kerr-lean (commit 99e57f1): the powerful-numbers proof and its import closure,
-- including Kerr/PNT (from PrimeNumberTheoremAnd, Apache-2.0; see NOTICE). Built on demand via
-- `FleetPowerfulNumbers`.
lean_lib Kerr where
  srcDir := "."
  globs := #[.submodules `Kerr]
